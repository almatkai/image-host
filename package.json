{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "image-host",
  "title": "Image Host",
  "description": "Host an image on imgBB",
  "icon": "assets/logo.png",
  "author": "almatkai",
  "categories": [
    "Media"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "host-image",
      "title": "Host Image",
      "description": "Host an image on imgBB",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "preferences": [
    {
      "name": "apiKey",
      "title": "IMGBB API Key",
      "description": "Your imgBB API key",
      "required": true,
      "type": "password",
      "defaultValue": ""
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.2",
    "imgbb-uploader": "^1.5.1",
    "imgur-uploader": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.image-host",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/image-host",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/image-host",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
